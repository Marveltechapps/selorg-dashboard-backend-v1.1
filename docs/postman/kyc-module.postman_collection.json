{
  "info": {
    "name": "KYC Module",
    "description": "Test the KYC document types, status, upload, and FAQ APIs. Set baseUrl and (after login) token in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "uploadedLink", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"userType\": \"rider\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/send-otp"
          }
        },
        {
          "name": "Verify OTP (get token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.tokens && json.tokens.accessToken) {",
                  "  pm.collectionVariables.set('token', json.tokens.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"code\": \"123456\",\n  \"userType\": \"rider\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-otp"
          }
        }
      ]
    },
    {
      "name": "KYC Document Types",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/kyc/document-types"
      }
    },
    {
      "name": "KYC Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/kyc/status"
      }
    },
    {
      "name": "KYC Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has uploadedLink', function () {",
              "  pm.expect(json).to.have.property('uploadedLink');",
              "  pm.expect(json.uploadedLink).to.be.a('string');",
              "});",
              "if (json.uploadedLink) { pm.collectionVariables.set('uploadedLink', json.uploadedLink); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "documentTypeCode", "value": "aadhar", "type": "text" },
            { "key": "file", "type": "file", "src": "" }
          ]
        },
        "url": "{{baseUrl}}/api/v1/kyc/upload",
        "description": "Upload a KYC document. Body: form-data with documentTypeCode and file. Response 200: documentTypeCode, status, uploadedLink (S3 URL), rejectedReason, uploadedAt, verifiedAt."
      },
      "response": [
        {
          "name": "Success (200)",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/api/v1/kyc/upload" },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"documentTypeCode\": \"aadhar\",\n  \"status\": \"pending\",\n  \"uploadedLink\": \"https://selorg-rider-documents.s3.ap-south-1.amazonaws.com/riders/user123/kyc/aadhar/1739xxx_file.jpg\",\n  \"uploadedAt\": \"2025-02-14T10:00:00.000Z\"\n}"
        }
      ]
    },
    {
      "name": "FAQ – KYC Documents",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/content/faq/account-faq-kyc-documents"
      }
    }
  ]
}
