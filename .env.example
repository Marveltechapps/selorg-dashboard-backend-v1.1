# ============================================
# Selorg Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Generate JWT_SECRET: openssl rand -base64 32

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
# Port the server listens on. All frontends (dashboard, HHD, Picker, Customer) default to this port.
PORT=5000
API_VERSION=1.0.0

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://username:password@host:port/database
# Or for Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://127.0.0.1:27017/selorg

# ============================================
# Security Configuration
# ============================================
# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
# NEVER commit this to version control
JWT_SECRET=your-secret-key-change-this-to-at-least-32-characters-long

# JWT access token expiry (e.g. 1h, 15m, 7d). Short-lived recommended for dashboard.
JWT_EXPIRES_IN=1h

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Example: https://dashboard.selorg.com,https://admin.selorg.com
# Leave empty in development to allow all origins (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per 15 minutes (general API, applied to /api/v1)
RATE_LIMIT_MAX=1000
# Failed login attempts per 15 min per IP (successful logins not counted)
AUTH_RATE_LIMIT_MAX=10
# Account lockout: max failed attempts per email before lockout
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
# Lockout duration in seconds (e.g. 900 = 15 min)
LOGIN_LOCKOUT_DURATION_SEC=900

# ============================================
# Logging Configuration
# ============================================
# Log levels: error, warn, info, debug
LOG_LEVEL=debug
# Enable file logging (true/false)
ENABLE_FILE_LOGGING=false

# ============================================
# Centralized Logging (Optional)
# ============================================
# ELK Stack (Elasticsearch)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme
# ELASTICSEARCH_INDEX=selorg-logs

# DataDog
# DATADOG_API_KEY=your-datadog-api-key
# DATADOG_HOSTNAME=your-hostname
# DATADOG_SERVICE=selorg-backend

# AWS CloudWatch
# AWS_REGION=us-east-1
# CLOUDWATCH_LOG_GROUP=selorg-backend
# CLOUDWATCH_LOG_STREAM=selorg-backend

# ============================================
# File Upload Configuration
# ============================================
FILE_UPLOAD_DIR=uploads/
# Max upload size in bytes (default 5242880 = 5MB). If you get HTTP 413 from photo uploads,
# ensure your reverse proxy (e.g. nginx) allows it: client_max_body_size 10m;
MAX_FILE_SIZE=5242880

# ============================================
# Monitoring & Metrics
# ============================================
# Enable Prometheus metrics (true/false)
ENABLE_METRICS=false
# Enable Swagger documentation in production (true/false)
ENABLE_SWAGGER=false

# ============================================
# WebSocket Configuration
# ============================================
# WebSocket port (defaults to same as HTTP server)
# WS_PORT=5000

# ============================================
# External Services (Optional)
# ============================================
# Email service configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password

# AWS Configuration (if using S3, etc.)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3 bucket for catalog product images (add-product uploads)
AWS_S3_BUCKET_PRODUCT_IMAGES=selorg-product-images

# ============================================
# Customer App (mounted at /customer)
# ============================================
# Optional: separate JWT for customer app auth (falls back to JWT_SECRET)
# CUSTOMER_JWT_SECRET=your-customer-jwt-secret-at-least-32-chars
# Twilio (for OTP SMS); if unset, SMS is mocked in dev
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM=+1234567890
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_TTL_SECONDS=300
# JWT_ACCESS_EXPIRES_SECONDS=86400

# ============================================
# Development/Testing
# ============================================
# Set to true to enable verbose logging
DEBUG=false

# ============================================
# OTP & SMS CONFIGURATION
# ============================================
# OTP Development Mode: No real SMS sent, OTP returned in API response for testing
# Set to 1 for development, 0 or remove for production (real SMS)
OTP_DEV_MODE=1

# SMS Provider Options:
# - For Twilio (global, works in India):
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# - For MSG91 (India DLT):
# MSG91_AUTH_KEY=your_auth_key
# MSG91_SENDER=SELLER
# MSG91_TEMPLATE_ID=your_dlt_template_id

# - For Fast2SMS (India):
# FAST2SMS_API_KEY=your_api_key
# FAST2SMS_ROUTE=otp

# - For custom SMS gateway: create config.json in backend root
# See OTP_FIX_SUMMARY.md for config.json structure
