# ============================================
# Backend .env for SERVER (65.2.159.247:5000)
# Copy this file to .env and fill in real values
# ============================================

NODE_ENV=production
PORT=5000

# MongoDB - replace with your actual MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/selorg-admin-ops
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/selorg-admin-ops

# JWT - generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-production-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# CORS - comma-separated frontend URLs that will call this API
# Use your frontend URL (where the dashboard is hosted)
ALLOWED_ORIGINS=http://65.2.159.247:3000,http://65.2.159.247:5173,http://localhost:3000,http://localhost:5173

# Optional
# API_VERSION=1.0.0
# ENABLE_SWAGGER=false
# ENABLE_METRICS=false
# FILE_UPLOAD_DIR=uploads
